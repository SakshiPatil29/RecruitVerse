# ---------------------------------------------------------------------------
# RecruitVerse ATS — environment configuration
# All values are OPTIONAL. The app runs out of the box with none of them set.
# ---------------------------------------------------------------------------

# Semantic matching model (any sentence-transformers model).
# Alternatives: all-mpnet-base-v2, BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Groq — used ONLY for AI narrative (summaries, questions, recommendations).
# Never used for scoring/ranking. If missing/invalid, rule-based fallbacks kick in.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

# Optional PostgreSQL persistence. Leave USE_DATABASE=false for session-only mode.
USE_DATABASE=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitverse

# How many rows/files to sample per dataset when building the knowledge base
# index for semantic candidate search.
KNOWLEDGE_BASE_SAMPLE_SIZE=3000

# Candidate search over PostgreSQL + pgvector (used only when USE_DATABASE=true).
# Let Groq turn the search text into JSON filters (years, must-have skills).
# It never writes SQL; a rule-based parser is used if Groq is unavailable.
USE_LLM_QUERY_PARSER=true
# Hide database matches below this cosine similarity (0-1). Tune on real queries.
DB_SEARCH_MIN_SIMILARITY=0.30
# Must match the vector(N) column in sql/schema.sql (384 for all-MiniLM-L6-v2).
EMBEDDING_DIM=384
