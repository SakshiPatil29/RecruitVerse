# ---------------------------------------------------------------------------
# RecruitVerse ATS — environment configuration
# All values are OPTIONAL. The app runs out of the box with none of them set.
# ---------------------------------------------------------------------------

# Semantic matching model (any sentence-transformers model).
# Alternatives: all-mpnet-base-v2, BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Ollama — used ONLY for AI narrative (summaries, questions, recommendations).
# Never used for scoring/ranking. If unreachable, rule-based fallbacks kick in.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=30

# Optional PostgreSQL persistence. Leave USE_DATABASE=false for session-only mode.
USE_DATABASE=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitverse

# How many rows/files to sample per dataset when building the knowledge base
# index for semantic candidate search.
KNOWLEDGE_BASE_SAMPLE_SIZE=3000
